# Normalize line endings; keep Windows scripts as CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.ttf binary
*.otf binary
*.jar binary

# Notebooks diff as text but count as documentation on GitHub
*.ipynb linguist-documentation
